{
	"name": "yosegaki",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run build:widget && bun --bun vite dev",
		"dev:widget": "vite build -c vite.widget.config.ts --watch",
		"build:widget": "svelte-kit sync && vite build -c vite.widget.config.ts",
		"build": "bun run build:widget && vite build",
		"start": "bun build/index.js",
		"test": "bun test",
		"check": "biome check --write && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.2",
		"@types/nodemailer": "^8.0.2",
		"@types/sanitize-html": "^2.16.2",
		"@typescript/native": "npm:typescript@7",
		"marked": "^18.1.0",
		"nodemailer": "^10.0.16",
		"sanitize-html": "^2.18.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"vite": "^8.3.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
