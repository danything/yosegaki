{
	"name": "yosegaki",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run build:widget && bun --bun vite dev",
		"dev:widget": "vite build -c vite.widget.config.ts --watch",
		"build:widget": "svelte-kit sync && vite build -c vite.widget.config.ts",
		"build": "bun run build:widget && vite build",
		"start": "bun build/index.js",
		"test": "bun test",
		"check": "biome check --write && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo"
	},
	"dependencies": {
		"jose": "^6.2.11",
		"marked": "^18.0.11",
		"nodemailer": "^10.0.0",
		"sanitize-html": "^2.17.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/bun": "^1.4.1",
		"@types/node": "^26.4.1",
		"@types/nodemailer": "^8.0.1",
		"@types/sanitize-html": "^2.16.1",
		"@typescript/native": "npm:typescript@7",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "~6",
		"vite": "^8.2.2"
	}
}
